{
  "name": "folio-reading",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local, reversible reading comfort for Chrome",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "benchmark": "node scripts/benchmark.mjs",
    "audit:licenses": "node scripts/licenses.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "@axe-core/playwright": "^4.10.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
